{
  "name": "classroom-review-system",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "turbo lint",
    "api:dev": "pnpm --filter @class-reflect/api dev",
    "web:dev": "pnpm --filter @class-reflect/web dev",
    "worker:dev": "pnpm --filter @class-reflect/worker dev",
    "worker:once": "pnpm --filter @class-reflect/worker start -- --once",
    "test:source": "node scripts/test-source.cjs",
    "workflow:real": "node --require ./scripts/register-source.cjs validation/workflow-foundation/real-acceptance.ts",
    "fewshot:refresh": "node --require ./scripts/register-source.cjs packages/database/scripts/refresh-few-shot.ts",
    "regression:freeze": "node --require ./scripts/register-source.cjs packages/database/scripts/freeze-regression-set.ts",
    "check:source": "tsc -p tsconfig.source-check.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
