{
  "name": "@class-reflect/agents",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "eval:mock": "tsc -p tsconfig.json && node dist/transcript-normalizer-agent/eval/cli.js",
    "eval:real": "tsc -p tsconfig.json && node dist/transcript-normalizer-agent/eval/cli.js --real",
    "eval:real:diagnose": "tsc -p tsconfig.json && node dist/transcript-normalizer-agent/eval/real-diagnostic-cli.js",
    "agent:run": "node dist/standalone.js"
  },
  "dependencies": {
    "@class-reflect/observability": "workspace:*",
    "@class-reflect/providers": "workspace:*",
    "@class-reflect/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
