PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Supabase: PostgreSQL + teacher login.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgres://postgres:postgres@localhost:5432/class_reflect
DIRECT_URL=postgres://postgres:postgres@localhost:5432/class_reflect

# Cloudflare R2: original videos, temporary audio and exported files.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=class-reflect-dev
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# ASR provider:
# aliyun = production file transcription for uploaded classroom videos
# mock   = local deterministic transcript, useful for frontend/backend smoke tests
ASR_PROVIDER=aliyun
ALIYUN_ASR_MODEL=qwen3-asr-flash-filetrans
# Use a fresh DashScope / Model Studio API key. Never commit a real key.
ALIYUN_DASHSCOPE_API_KEY=your-dashscope-api-key
ALIYUN_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_ASR_POLL_INTERVAL_MS=3000
ALIYUN_ASR_TIMEOUT_MS=600000
ALIYUN_ASR_FILE_URL_EXPIRES_SECONDS=3600
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret

# Alibaba-compatible LLM endpoint for classroom events, evidence cards and reports.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=qwen-plus

# Must be installed on the machine for real processing.
FFMPEG_PATH=ffmpeg
