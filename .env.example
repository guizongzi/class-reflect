PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/class_reflect

# 阿里云 OSS。第一版只选 OSS 一个对象存储。
# endpoint 按实际地域替换，例如：https://oss-cn-hangzhou.aliyuncs.com
S3_REGION=oss-cn-hangzhou
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_BUCKET=class-reflect-dev
S3_ACCESS_KEY_ID=your-aliyun-access-key-id
S3_SECRET_ACCESS_KEY=your-aliyun-access-key-secret
S3_FORCE_PATH_STYLE=false

# ASR provider:
# mock   = local deterministic transcript, useful for frontend/backend smoke tests
# openai = real audio transcription + optional translation
ASR_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSLATE_MODEL=gpt-4o-mini-transcribe

# Must be installed on the machine for real processing.
FFMPEG_PATH=ffmpeg
